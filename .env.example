# Copy this file to `.env` and fill in the key. Never commit `.env` (it is git-ignored).
# Only META_MODEL_API_KEY is required. Create keys at https://dev.meta.ai/api-keys/
META_MODEL_API_KEY=
META_API_BASE_URL=https://api.meta.ai/v1

# Standard-tier models by default. Per Meta's docs, standard-mode content is not used to train Meta models.
REFORGE_MODEL_REASONING=muse-spark-1.3
REFORGE_MODEL_SEGMENTATION=sam-3.1
REFORGE_MODEL_IMAGE=muse-image-1.0

# Contributor tier: content MAY be used to train future Meta models, and retention isn't documented.
# Allowed ONLY for synthetic images or our own non-sensitive test images. Never for user uploads. Default: off.
REFORGE_ALLOW_CONTRIBUTOR_TIER=false

# Daily spend guard (USD, per UTC day) across all Meta API calls made by the app.
REFORGE_DAILY_BUDGET_USD=5

# Web server: defaults 127.0.0.1:8000 (local only). The Docker image sets 0.0.0.0 itself, so leave these commented
# out when you pass this file to `docker run --env-file`, or the container would only listen on its own loopback.
# REFORGE_HOST=127.0.0.1
# REFORGE_PORT=8000
# Jobs analysed at once, and how many more may wait; beyond that, new jobs get SERVER_BUSY.
REFORGE_MAX_RUNNING_JOBS=2
REFORGE_MAX_QUEUED_JOBS=8
